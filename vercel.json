{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "pnpm --filter @workspace/mobile run build",
  "outputDirectory": "artifacts/mobile/static-build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://onrender.com"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
