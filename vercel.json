{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "mobile-frontend": {
      "root": "artifacts/mobile",
      "framework": null,
      "buildCommand": "pnpm --filter @workspace/mobile run build",
      "outputDirectory": "static-build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "mobile-frontend"
      }
    }
  ]
}
