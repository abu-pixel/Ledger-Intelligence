{
  "$schema": "https://vercel.sh",
  "services": {
    "mobile-app": {
      "root": "artifacts/mobile",
      "buildCommand": "pnpm --filter @workspace/mobile run build",
      "outputDirectory": "static-build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://onrender.com"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "mobile-app"
      }
    }
  ]
}
